# Lite Environment Configuration for Development
# Minimal settings for quick API testing

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_BASE_URL=http://localhost:8002
FRONTEND_URL=http://localhost:3000

# Database Configuration (Lite)
DATABASE_URL=postgresql+asyncpg://koluser:kolpassword@localhost:5433/kolsystem_dev
DATABASE_NAME=kolsystem_dev
DATABASE_USER=koluser
DATABASE_PASSWORD=kolpassword
DATABASE_HOST=localhost
DATABASE_PORT=5433

# Redis Configuration (Lite)
REDIS_URL=redis://localhost:6381/0
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=

# Celery Configuration (Lite)
CELERY_BROKER_URL=redis://localhost:6381/1
CELERY_RESULT_BACKEND=redis://localhost:6381/2

# JWT Authentication (Development)
JWT_SECRET_KEY=dev-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Security Settings (Development)
CORS_ORIGINS=http://localhost:3000,http://localhost:8002,http://127.0.0.1:3000
ALLOWED_HOSTS=localhost,127.0.0.1,kol_web_lite

# Minimal Logging
LOG_LEVEL=INFO
LOG_FORMAT=simple

# Note: Heavy dependencies and external services disabled for lite version
# - No AI/ML services
# - No social media integrations
# - No email services
# - No monitoring services