# Factory ERP System - Development Environment
# This file is used for development and testing

# Application Configuration
APP_NAME="Factory ERP System"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Host and Port Configuration
HOST_PORT=8000
HOST=0.0.0.0

# Security Configuration
SECRET_KEY=development-secret-key-32-characters-minimum-for-testing
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database Configuration
POSTGRES_DB=factory_erp_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=dev_password
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:dev_password@postgres:5432/factory_erp_dev

# Authentication & JWT Configuration
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# ERPNext Integration (disabled for development)
ERPNEXT_BASE_URL=
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
ERPNEXT_SYNC_ENABLED=false

# Redis Configuration
REDIS_PASSWORD=dev_redis_password
REDIS_HOST_PORT=6379
REDIS_URL=redis://:dev_redis_password@redis:6379/0

# Server Configuration
WORKERS=2
WORKER_CLASS=uvicorn.workers.UvicornWorker
LOG_LEVEL=debug

# Development Settings
RUN_SEED_DATA=true
HEALTH_CHECK_VERBOSE=true