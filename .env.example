# KOL Management System Environment Configuration
# Copy this file to .env and configure your values

# ====================================
# APPLICATION SETTINGS
# ====================================
ENVIRONMENT=production
DEBUG=false
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
SECRET_KEY=your-super-secret-key-change-in-production

# ====================================
# DATABASE CONFIGURATION
# ====================================
DATABASE_URL=postgresql+asyncpg://koluser:kolpassword@localhost:5432/kolsystem
DATABASE_NAME=kolsystem
DATABASE_USER=koluser
DATABASE_PASSWORD=kolpassword
DATABASE_HOST=postgres
DATABASE_PORT=5432

# ====================================
# REDIS CONFIGURATION
# ====================================
REDIS_URL=redis://:redispassword@localhost:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redispassword

# ====================================
# CELERY CONFIGURATION
# ====================================
CELERY_BROKER_URL=redis://:redispassword@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redispassword@localhost:6379/2

# ====================================
# JWT AUTHENTICATION
# ====================================
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ====================================
# SECURITY SETTINGS
# ====================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_HOSTS=localhost,127.0.0.1,kol_web
SECURITY_ALERT_EMAILS=admin@example.com
SUPPORT_EMAIL=support@example.com

# ====================================
# EMAIL CONFIGURATION
# ====================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@kolsystem.com

# ====================================
# SOCIAL MEDIA API KEYS
# ====================================
# Instagram
INSTAGRAM_CLIENT_ID=your-instagram-client-id
INSTAGRAM_CLIENT_SECRET=your-instagram-client-secret

# YouTube
YOUTUBE_API_KEY=your-youtube-api-key

# Twitter/X
TWITTER_API_KEY=your-twitter-api-key
TWITTER_API_SECRET=your-twitter-api-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret

# TikTok
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# Facebook
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ====================================
# AI SERVICES
# ====================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=your-openai-org-id

# ====================================
# COMMUNICATION SERVICES
# ====================================
# Discord Bot
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=your-discord-guild-id

# Line Messaging
LINE_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LINE_CHANNEL_SECRET=your-line-channel-secret

# ====================================
# DOCKER SERVICES PORTS
# ====================================
WEB_PORT=8000
DATABASE_PORT=5432
REDIS_PORT=6379
FLOWER_PORT=5555
NGINX_PORT=80
NGINX_SSL_PORT=443
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# ====================================
# MONITORING CREDENTIALS
# ====================================
FLOWER_USER=admin
FLOWER_PASSWORD=flowerpassword
GRAFANA_PASSWORD=grafanapassword

# ====================================
# FILE STORAGE
# ====================================
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,xls,xlsx
STATIC_FILES_PATH=/app/static
UPLOADS_PATH=/app/uploads

# ====================================
# LOGGING
# ====================================
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=your-sentry-dsn-url-for-error-tracking

# ====================================
# RATE LIMITING
# ====================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10

# ====================================
# BACKUP CONFIGURATION
# ====================================
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
S3_BACKUP_BUCKET=kol-system-backups
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# ====================================
# SSL/TLS CONFIGURATION
# ====================================
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key
SSL_REDIRECT=false

# ====================================
# DEVELOPMENT OVERRIDES
# ====================================
# Uncomment for development
# ENVIRONMENT=development
# DEBUG=true
# SKIP_DB_WAIT=false
# SKIP_REDIS_WAIT=false
# SKIP_MIGRATIONS=false
# SKIP_SEED_DATA=false