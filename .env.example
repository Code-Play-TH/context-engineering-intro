# Factory ERP System - Environment Configuration Template
# Copy this file to .env and configure your values

# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME="Factory ERP System"
APP_VERSION="1.0.0"
DEBUG=false
ENVIRONMENT=production

# Host and Port Configuration
HOST_PORT=8000
HOST=0.0.0.0

# Security Configuration
SECRET_KEY=your-super-secret-key-at-least-32-characters-long
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,https://your-domain.com

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL Database Settings
POSTGRES_DB=factory_erp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-database-password
POSTGRES_HOST_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your-secure-database-password@postgres:5432/factory_erp

# =============================================================================
# Authentication & JWT Configuration
# =============================================================================
# JWT token expiration settings
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ALGORITHM=HS256

# Password hashing settings
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SPECIAL_CHARS=true

# =============================================================================
# ERPNext Integration Configuration
# =============================================================================
# ERPNext server details
ERPNEXT_BASE_URL=https://your-erpnext-instance.com
ERPNEXT_API_KEY=your-erpnext-api-key
ERPNEXT_API_SECRET=your-erpnext-api-secret
ERPNEXT_SYNC_ENABLED=true
ERPNEXT_SYNC_INTERVAL_MINUTES=15

# =============================================================================
# Redis Configuration (Optional)
# =============================================================================
REDIS_PASSWORD=your-redis-password
REDIS_HOST_PORT=6379
REDIS_URL=redis://:your-redis-password@redis:6379/0

# =============================================================================
# Server Configuration
# =============================================================================
# Gunicorn worker settings
WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
WORKER_CONNECTIONS=1000
MAX_REQUESTS=1000
MAX_REQUESTS_JITTER=100
TIMEOUT=30
KEEP_ALIVE=2
LOG_LEVEL=info

# =============================================================================
# File Upload Configuration
# =============================================================================
# File upload limits and settings
MAX_UPLOAD_SIZE_MB=50
ALLOWED_UPLOAD_EXTENSIONS=xlsx,xls,csv,pdf,png,jpg,jpeg
UPLOAD_DIR=/app/uploads

# =============================================================================
# Email Configuration (Optional)
# =============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_TLS=true
SMTP_SSL=false
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME="Factory ERP System"

# =============================================================================
# Nginx Configuration (Optional)
# =============================================================================
NGINX_PORT=80
NGINX_SSL_PORT=443

# =============================================================================
# Monitoring and Logging
# =============================================================================
# Health check settings
HEALTH_CHECK_TIMEOUT=10
HEALTH_CHECK_VERBOSE=false

# Log levels: debug, info, warning, error, critical
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=5

# =============================================================================
# Development Settings
# =============================================================================
# Database seeding
RUN_SEED_DATA=false

# Development tools
ENABLE_DEBUG_TOOLBAR=false
ENABLE_PROFILER=false

# Testing
TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@localhost:5432/factory_erp_test

# =============================================================================
# Build Configuration
# =============================================================================
BUILD_DATE=
VCS_REF=