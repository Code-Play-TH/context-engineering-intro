# Application Environment
ENVIRONMENT=development  # development, staging, production

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres_secure_password@localhost:5432/kol_management
TEST_DATABASE_URL=postgresql://postgres:postgres_test@localhost:5433/kol_management_test

# PostgreSQL Credentials (for docker-compose)
POSTGRES_PASSWORD=postgres_secure_password
PGADMIN_PASSWORD=admin

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# JWT Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Reset
PASSWORD_RESET_EXPIRE_HOURS=1

# Rate Limiting
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=30

# Social Media API Keys (Phase 2)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
TIKTOK_API_KEY=
YOUTUBE_API_KEY=
TWITTER_API_KEY=
TWITTER_API_SECRET=

# Communication API Keys
LINE_CHANNEL_ACCESS_TOKEN=
DISCORD_BOT_TOKEN=

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@kol-management.com
SMTP_FROM_NAME=KOL Management System

# AI/LLM API Keys (Phase 3)
OPENAI_API_KEY=
# or
ANTHROPIC_API_KEY=

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMPORT_EXTENSIONS=csv,xlsx,xls

# Application Settings
API_V1_PREFIX=/api/v1
PROJECT_NAME=KOL Influencer Management System
DEBUG=true

# CORS Settings
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
